# All optional; defaults shown.
DATABASE_URL=sqlite:///./duolingo.db
CORS_ORIGINS=http://localhost:3000
HEART_REGEN_MINUTES=30
ENABLE_DEV_TOOLS=true
DEFAULT_USERNAME=learner
DEFAULT_TIMEZONE=UTC

# Razorpay (optional). Copy this file to backend/.env (git-ignored) and fill in TEST MODE keys
# from Razorpay Dashboard -> Test Mode -> Settings -> API Keys. Leave empty to disable payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Only needed if you configure a webhook (Dashboard -> Webhooks -> event: payment.captured)
RAZORPAY_WEBHOOK_SECRET=
PREMIUM_PRICE_INR=499
PREMIUM_DAYS=30
